<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色模式：偏蓝渐变；insetTop 让卡片整体下移与系统小组件对齐。 -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="12dp">
    <shape android:shape="rectangle">
        <corners android:radius="26dp" />
        <gradient
            android:angle="315"
            android:startColor="#EFF3FB"
            android:centerColor="#E2EAF7"
            android:endColor="#CFDFF3" />
        <stroke android:width="1dp" android:color="#A8FFFFFF" />
    </shape>
</inset>
